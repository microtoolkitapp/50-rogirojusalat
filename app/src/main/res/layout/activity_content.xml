<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@drawable/circle_background"
tools:context=".Content">
<com.google.android.gms.ads.AdView
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adView"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerHorizontal="true"
    android:layout_alignParentTop="true"
    ads:adSize="BANNER"
    ads:adUnitId="@string/app_banner">
</com.google.android.gms.ads.AdView>

    <LinearLayout
        android:id="@+id/toolsBar"
        android:layout_below="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#015283"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/lisabojcharulota"
            android:text="পাপ-পুণ্য লিখার নিয়ম ও আল্লাহর অনুগ্রহ"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:onClick="decreaseFont"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_circle"
            android:gravity="center"
            android:text="অ-"
            android:textColor="@color/islamicGreen"
            android:textStyle="bold" />

        <TextView
            android:onClick="increaseFont"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_circle"
            android:gravity="center"
            android:text="অ+"
            android:textColor="@color/islamicGreen"
            android:textStyle="bold" />

        <ImageView
            android:onClick="toggleDarkMode"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_circle"
            android:padding="8dp"
            android:src="@drawable/ic_moon" />

        <ImageView
            android:id="@+id/favoriteIcon"
            android:onClick="toggleFavorite"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_circle"
            android:padding="7dp"
            android:src="@drawable/ic_heart_outline" />
    </LinearLayout>

<ScrollView
    android:id="@+id/scrollview"
    android:layout_below="@+id/toolsBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:padding="5dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:background="@color/white"
                android:id="@+id/webview1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <View
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
<TableLayout
    android:layout_alignParentBottom="true"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="2"
    android:stretchColumns="*">
    <TableRow android:background="@color/white"  android:padding="5dp">
        <TextView
            android:onClick="shareHere"
            android:background="@drawable/round_corner"
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Share"
            android:id="@+id/share"
            android:layout_marginRight="10dp"
            android:padding="5dp"
            android:layout_weight="1"/>
        <TextView
            android:onClick="copyHere"
            android:background="@drawable/round_corner"
            android:id="@+id/copy"
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Copy"
            android:layout_marginLeft="10dp"
            android:padding="5dp"
            android:layout_weight="1"/>

    </TableRow>
</TableLayout>
</RelativeLayout>
