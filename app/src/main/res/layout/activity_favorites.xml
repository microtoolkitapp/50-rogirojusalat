<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
xmlns:ads="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@drawable/circle_background"
tools:context=".Favorites">
<com.google.android.gms.ads.AdView
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adView"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerHorizontal="true"
    android:layout_alignParentTop="true"
    ads:adSize="BANNER"
    ads:adUnitId="@string/app_banner">
</com.google.android.gms.ads.AdView>
    <TextView
        android:layout_below="@+id/adView"
        android:gravity="center"
        android:padding="14dp"
        android:id="@+id/main"
        android:background="#015283"
        android:text="আমার পছন্দের তালিকা"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/lisabojcharulota" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_below="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:fontFamily="@font/lisabojcharulota"
        android:gravity="center"
        android:padding="20dp"
        android:text="এখনো কোনো বিষয় পছন্দের তালিকায় যোগ করা হয়নি।\nযেকোনো লেখা খুলে ♥ আইকনে চাপ দিয়ে যোগ করুন।"
        android:textColor="@color/textSecondary"
        android:textSize="15sp"
        android:visibility="gone" />

<ScrollView
    android:layout_below="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/favoritesContainer"
        android:padding="15dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    </LinearLayout>
</ScrollView>
</RelativeLayout>
